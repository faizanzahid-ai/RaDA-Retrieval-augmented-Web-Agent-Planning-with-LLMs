      "expected_subtasks": [
        "Navigate to search bar",
        "Enter search query 'wireless headphones'",
        "Apply price filter under $50",
        "Apply rating filter 4+ stars",
        "View search results"
      ],
      "difficulty": "easy",
      "success_criteria": "Search results page shows wireless headphones with price < $50 and rating >= 4 stars"
    },
